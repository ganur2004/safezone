# server
PORT=8787
DEMO_MODE=false
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# NWS requires a contact in the User-Agent header
NWS_USER_AGENT=SafeZone (your-email@example.com)
AWS_REGION=ap-southeast-2
AMAZON_LOCATION_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173

# agent
AGENT_PORT=8788
MCP_SERVER_URL=http://localhost:8787/mcp
# false runs the scripted fallback, which needs no AWS account (SPEC 7.4)
BEDROCK_ENABLED=false
# Any tool-capable model enabled in your region's Bedrock "Model access"
# Inference profiles are Region-scoped: "au." in Sydney, "us." in the US
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-5
# Polly text to speech; defaults to BEDROCK_ENABLED. Off means the browser voice.
POLLY_ENABLED=false
POLLY_VOICE_ID=Joanna

# web
VITE_AGENT_URL=http://localhost:8788
# Optional: a MapLibre style URL. Defaults to the keyless OpenFreeMap dark style.
VITE_MAP_STYLE_URL=
