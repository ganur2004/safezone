# server
PORT=8787
DEMO_MODE=false
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# NWS requires a contact in the User-Agent header
NWS_USER_AGENT=SafeZone (your-email@example.com)
AWS_REGION=us-east-1
AMAZON_LOCATION_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173

# agent (milestone M4)
MCP_SERVER_URL=http://localhost:8787/mcp
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=
POLLY_VOICE_ID=Joanna

# web
# Until the agent service exists (M4) the simulator calls the MCP server directly.
VITE_MCP_URL=http://localhost:8787/mcp
VITE_AGENT_URL=http://localhost:8788
# Optional: a MapLibre style URL. Defaults to the keyless OpenFreeMap dark style.
VITE_MAP_STYLE_URL=
