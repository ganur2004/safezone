{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // The CDK typings are not written for exactOptionalPropertyTypes.
    "exactOptionalPropertyTypes": false
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"]
}
