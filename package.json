{
  "name": "safezone",
  "private": true,
  "version": "0.1.0",
  "description": "SafeZone \u2014 voice safety assistant with a map, built on an MCP server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "agent",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --build --force",
    "inspector": "npx -y @modelcontextprotocol/inspector",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "record-fixtures": "node --experimental-strip-types scripts/record-fixtures.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "dev:web": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:agent": "npm run dev --workspace agent"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
